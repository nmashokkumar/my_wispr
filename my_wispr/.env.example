# GEMINI_API_KEY: Required for built-in Gemini transcription & cleanup when no custom upstream server is set.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# FLOW_API_KEY: Optional shared secret to protect /transcribe and /v1/audio/transcriptions when sharing your server.
# Clients send this via the API Key field in Settings (X-API-Key / Authorization: Bearer).
FLOW_API_KEY=""

# UPSTREAM_TRANSCRIBE_URL: Optional self-hosted Whisper / Faster-Whisper / Speaches / whisper.cpp / OpenAI-compatible server URL.
# Examples:
#   http://127.0.0.1:8080          (whisper.cpp server -> POST /inference)
#   http://127.0.0.1:8000/v1       (Faster-Whisper / Speaches / OpenAI-compatible -> POST /audio/transcriptions)
# Leave blank to use the built-in server-side Gemini transcription engine.
UPSTREAM_TRANSCRIBE_URL=""
UPSTREAM_TRANSCRIBE_FORMAT="auto"
UPSTREAM_TRANSCRIBE_MODEL="whisper-1"
UPSTREAM_TRANSCRIBE_API_KEY=""

# UPSTREAM_CLEANUP_URL: Optional OpenAI-compatible LLM endpoint (e.g., local Ollama / llama.cpp http://127.0.0.1:11434/v1)
# for OpenWhispr-style tone/style post-processing. Leave blank to use Gemini / deterministic cleanup.
UPSTREAM_CLEANUP_URL=""
UPSTREAM_CLEANUP_MODEL=""
UPSTREAM_CLEANUP_API_KEY=""

# CORS_ORIGINS: Optional comma-separated list of allowed desktop/web origins (e.g. http://localhost:5173,app://flow)
CORS_ORIGINS=""

# VITE_FLOW_API_URL: Optional default server URL prefilled in Settings (defaults to this server's origin).
VITE_FLOW_API_URL=""
